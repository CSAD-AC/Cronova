<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sjdt.scheduler.mapper.RoleMapper">
    <insert id="addRolesForUser">
        INSERT INTO user_roles (user_id, role_id) 
        VALUES (#{userId}, #{roleId})
    </insert>

    <select id="selectRolesByUserId" resultType="com.sjdt.scheduler.domain.po.Role">
        SELECT
            r.id, r.name, r.create_time AS createTime
        FROM
            roles r
                JOIN
            user_roles ur ON r.id = ur.role_id
        WHERE
            ur.user_id = #{userId}
    </select>

    <delete id="clearUserRoles">
        DELETE FROM user_roles WHERE user_id = #{userId}
    </delete>

    <insert id="batchAddRolesForUser">
        INSERT INTO user_roles (user_id, role_id)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <select id="selectRoleIdsByUserId" resultType="java.lang.Integer">
        SELECT role_id FROM user_roles WHERE user_id = #{userId}
    </select>

</mapper>