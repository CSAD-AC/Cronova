<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cronova.scheduler.mapper.AKSKMapper">

    <!-- 根据 Access Key 查询 AKSK 信息 -->
    <select id="selectByAccessKey" resultType="com.cronova.scheduler.domain.po.AKSK">
        SELECT * FROM aksks WHERE access_key = #{accessKey}
    </select>

</mapper>