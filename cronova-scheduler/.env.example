# 调度器环境变量模板
# 复制为 .env 后按需修改（首次部署：cp .env.example .env）

# Worker 注册令牌（必须与 Worker 的 REGISTER_TOKEN 一致）
WORKER_REGISTER_TOKEN=change-me

# 调度器监听端口（compose 使用 host 网络，直接占用宿主机端口）
SERVER_PORT=8085

# MySQL（调度器库；首次启动 Flyway 自动建表）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scheduler
DB_USERNAME=root
DB_PASSWORD=changeme

# Redis（分布式锁 / Worker 路由快照 / 缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=changeme

# RocketMQ（任务下发 / 结果回报）
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=scheduler-producer
ROCKETMQ_CONSUMER_GROUP=scheduler-consumer

# MinIO（脚本存储 / 任务日志存储）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=task-engine
