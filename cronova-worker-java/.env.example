# Java 执行器环境变量模板
# 复制为 .env 后按需修改（首次部署：cp .env.example .env）

# 调度器配置（本地容器运行用 host.docker.internal，服务器部署改为调度器实际地址）
SCHEDULER_BASE_URL=http://host.docker.internal:8085

# Worker 注册令牌（必须与调度器 WORKER_REGISTER_TOKEN 一致，首次注册/重注册时校验）
# 留空则不携带该头，适用于调度器未启用令牌的兼容场景
REGISTER_TOKEN=change-me

# Worker 标签配置（逗号分隔，用于任务依赖匹配）
# 示例: V1,Python3.11
WORKER_TAGS=V1,Python3.11

# 定时任务配置（秒）
HEARTBEAT_INTERVAL=2
STATUS_REPORT_INTERVAL=10
TASK_STATUS_INTERVAL=5
TAG_CHECK_INTERVAL=60

# RocketMQ 配置
MQ_NAMESRV_ADDR=127.0.0.1:9876
MQ_CONSUMER_GROUP=WORKER_EXECUTOR_GROUP
MQ_PRODUCER_GROUP=WORKER_EXECUTOR_GROUP
MQ_TASK_TOPIC=TASK_EXECUTE
MQ_TASK_RESULT_TOPIC=TASK_RESULT
MQ_TASK_CONTROL_TOPIC=TASK_CONTROL

# MinIO 配置（注意 endpoint 必须带 http:// 或 https:// 前缀）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_SECURE=False
MINIO_BUCKET_NAME=task-engine

